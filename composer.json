{
    "name": "tyhpdef/fruitcake-php-cors-impl",
    "description": "Implementation package for tyhpdef/fruitcake-php-cors. Require tyhpdef/fruitcake-php-cors, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.4.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/fruitcake-php-cors"
        }
    },
    "require": {
        "php": ">=8.2",
        "fruitcake/php-cors": "1.4.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev"
    }
}
